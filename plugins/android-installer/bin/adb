#!/usr/bin/env bash
# Internal-use only: not for direct/agent invocation (blocked by scripts/android-adb-guard.sh).
# Exists solely so adb-wireless's internal shell-out to bare `adb` during pairing
# finds this instead of a system adb. Agents should call android-installer-adb directly.
exec "$(cd "$(dirname "$0")" && pwd)/android-installer-adb" "$@"
